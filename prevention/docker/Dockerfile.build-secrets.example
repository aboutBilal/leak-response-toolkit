# syntax=docker/dockerfile:1
# Using a secret during a build without baking it into any layer.
#
# Build:  docker build --secret id=npm_token,env=NPM_TOKEN -t app .
#
# Wrong:  ARG NPM_TOKEN / ENV NPM_TOKEN=...  -> visible in `docker history` and the image config
# Wrong:  COPY .npmrc . then RUN rm .npmrc   -> still inside the earlier layer

FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
# The secret is mounted at /run/secrets/npm_token for this one command only.
RUN --mount=type=secret,id=npm_token \
    NPM_TOKEN="$(cat /run/secrets/npm_token)" npm ci --omit=dev
COPY . .

FROM node:22-slim
WORKDIR /app
COPY --from=build /app ./
USER node
CMD ["node", "server.js"]
