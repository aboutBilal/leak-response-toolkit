# --- Secrets: never commit these ------------------------------------------
# Append to your .gitignore, or use as a global ignore for every repo on a machine:
#   git config --global core.excludesFile ~/.gitignore-secrets

# Environment files (commit a .env.example with placeholders instead)
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Private keys and certificates with keys
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
!*.pub

# Cloud and cluster credentials
.aws/
.azure/
.config/gcloud/
*credentials*.json
*service-account*.json
kubeconfig
*.kubeconfig

# Infrastructure state and local overrides (state files contain secrets in plain text)
*.tfstate
*.tfstate.*
.terraform/
*.auto.tfvars
override.tf
override.tf.json

# Tool caches that can hold tokens
.npmrc
.pypirc
.netrc
.docker/config.json

# Evidence and reports from incident tooling
evidence/
hunts/
*secrets-report*.json
