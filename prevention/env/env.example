# .env.example: commit THIS file, never .env.
# It documents which settings the app needs, with placeholders only.
#
# Local development, best first:
#   1. A secret manager injects values at start-up, so no file holds them
#      (most managers have a "run" command that sets variables for one process).
#   2. Encrypted files in Git (SOPS, git-crypt), decrypted only on authorised machines.
#   3. A local .env copied from this file, ignored by Git, filled from the team's vault.

APP_ENV=development
APP_PORT=8080
API_BASE_URL=https://api.example.com

# Secrets: fill locally from the vault. Never paste real values into this file.
DATABASE_URL=
PAYMENT_API_KEY=
SESSION_SIGNING_KEY=
