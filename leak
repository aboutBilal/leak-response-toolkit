#!/usr/bin/env bash
# leak - one entry point for Spillkit.
#
# Usage: leak <command> [arguments]        (every command also takes --help)
#
# Prevent
#   audit [--no-scan] [--json] [path]       grade a repository's secret hygiene, A to F
#   audit-org [--no-scan] <org> | --dir d   grade every repository; HTML dashboard
# Respond
#   snapshot <owner>/<repo> [dir]           save evidence before the repository is deleted
#   scan <path> [report.json] [--sarif f]   find secrets in every commit (values redacted)
#   forks <owner>/<repo>                    list every fork, for the takedown request
#   hunt [--since date] <owner>/<repo>      check GitHub, GitLab, web archives and code search for copies
#   commits [--exclude o/r] <sha> ...       find public repositories containing the original commits
#   report <hunt-dir> [--scan r.json]       build the leadership report from the results
#   notify [--format f] <message>           alert Slack, Teams or Discord (URL from LEAK_WEBHOOK_URL)
# Setup
#   doctor [--offline]                      check this machine is ready, before an incident
#   help [command] | version
#
# Exit codes: 0 clean, 1 findings, 2 usage error, 4 incomplete (a scanner or service failed)
# In an incident: README.md, section "Responding to a leak", or docs/01-runbook.md
set -euo pipefail

VERSION="3.3.0"

# Follow symlinks (make install, the container image) to find scripts/ next to the
# real file. Portable: does not rely on `readlink -f` (missing on older macOS).
resolve() {
  local path="$1" dir target
  while [[ -L "$path" ]]; do
    dir="$(cd "$(dirname "$path")" && pwd)"
    target="$(readlink "$path")"
    [[ "$target" == /* ]] && path="$target" || path="$dir/$target"
  done
  cd "$(dirname "$path")" && pwd
}
here="$(resolve "${BASH_SOURCE[0]}")"

script_for() {
  case "$1" in
    snapshot) echo "snapshot-evidence.sh" ;;
    scan) echo "scan-secrets.sh" ;;
    forks) echo "list-forks.sh" ;;
    hunt) echo "hunt-copies.sh" ;;
    commits) echo "find-commit-copies.sh" ;;
    report) echo "make-report.sh" ;;
    doctor) echo "doctor.sh" ;;
    audit) echo "audit.sh" ;;
    audit-org) echo "audit-org.sh" ;;
    notify) echo "notify.sh" ;;
    *) return 1 ;;
  esac
}

usage() { sed -n '2,/^set -/{/^#/s/^# \{0,1\}//p;}' "$0"; }

cmd="${1:-help}"
shift || true
case "$cmd" in
  help|-h|--help)
    if [[ -n "${1:-}" ]] && s="$(script_for "$1")"; then exec "$here/scripts/$s" --help; fi
    usage ;;
  version|-v|--version)
    echo "spillkit $VERSION" ;;
  *)
    if s="$(script_for "$cmd")"; then
      exec "$here/scripts/$s" "$@"
    fi
    echo "unknown command: $cmd" >&2
    echo "run 'leak help' for the list" >&2
    exit 2 ;;
esac
